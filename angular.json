{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "software-engineer-lab": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/software-engineer-lab",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": []
          },
          "configurations": {
            "production": {"budgets": [{"type": "initial", "maximumWarning": "500kB", "maximumError": "1MB"}], "outputHashing": "all"}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {"production": {"buildTarget": "software-engineer-lab:build:production"}, "development": {"buildTarget": "software-engineer-lab:build"}},
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
